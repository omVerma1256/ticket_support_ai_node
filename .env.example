# Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supportTicketAi
DB_USER=postgres
DB_PASSWORD=123456

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# CORS - Allowed origins
# Use * to allow ALL origins (development / open APIs)
# Use comma-separated URLs for specific origins in production:
# CORS_ORIGIN=https://yourapp.com,https://admin.yourapp.com
CORS_ORIGIN=*
